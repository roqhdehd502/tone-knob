# Auth Service
AUTH_SVC_PORT=3001

# Database (Supabase) — 공유 DB, 각 서비스별 독립 커넥션 풀 사용
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# JWT — auth-svc에서 토큰 서명, gateway/jam-svc에서 검증 (동일 값 필수)
JWT_SECRET=your-jwt-secret-key
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Marketplace Service (event target) — AUTH_EVENTS.USER_LOGGED_IN → Knob 일일 로그인 적립
MARKETPLACE_SVC_HOST=localhost
MARKETPLACE_SVC_PORT=3006

# Environment
NODE_ENV=development
