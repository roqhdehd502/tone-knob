# Tab Service
TAB_SVC_PORT=3002

# Database (Supabase) — 공유 DB, 각 서비스별 독립 커넥션 풀 사용
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Redis — 타브 목록 캐싱 (30초 TTL, 연결 실패 시 캐시 없이 정상 동작)
REDIS_URL=redis://localhost:6379

# Community Service (event target)
COMMUNITY_SVC_HOST=localhost
COMMUNITY_SVC_PORT=3005

# Marketplace Service (event target) — TAB_EVENTS.CREATED → Knob 자동 적립
MARKETPLACE_SVC_HOST=localhost
MARKETPLACE_SVC_PORT=3006

# Environment
NODE_ENV=development
