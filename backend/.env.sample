# ================================================================
# Tone Knob Backend – 환경변수 샘플
# 로컬 개발: DB_* 변수 사용
# Supabase / 프로덕션: DATABASE_URL 하나로 대체 (DB_* 무시됨)
# ================================================================

# ── App ─────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
# 배포된 프론트엔드 URL (Vercel) → CORS 허용에 사용
FRONTEND_URL=

# ── JWT ─────────────────────────────────────────────────────────
# 반드시 64자 이상의 랜덤 문자열로 교체하세요 (프로덕션)
JWT_SECRET=JWT_SECRET
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ── 로컬 PostgreSQL (DATABASE_URL 없을 때 사용) ──────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_NAME=tone_knob
DB_POOL_MAX=20
DB_POOL_MIN=2

# Read Replica (선택, 로컬 개발용)
# DB_REPLICA_HOST=localhost
# DB_REPLICA_PORT=5433
# DB_REPLICA_USERNAME=postgres
# DB_REPLICA_PASSWORD=

# ── Supabase (프로덕션 / 스테이징) ──────────────────────────────
# Supabase 프로젝트 대시보드 → Settings → Database → Connection string
#
# Transaction Pooler (NestJS 권장, port 6543):
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
#
# Direct Connection (마이그레이션 실행 시 사용, port 5432):
# DIRECT_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-xx-xxxx-x.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Supabase 프로젝트 정보 (프론트엔드 연동 시 필요)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── CDN / Storage ────────────────────────────────────────────────
# Supabase Storage를 사용하는 경우:
# CDN_BASE_URL=https://[PROJECT-REF].supabase.co/storage/v1/object/public
# S3_BASE_URL=https://[PROJECT-REF].supabase.co/storage/v1
CDN_BASE_URL=
S3_BASE_URL=

# ── AI / ML 서버 ─────────────────────────────────────────────────
ML_SERVER_URL=http://localhost:8001

# ── 다중 지역 미디어 서버 (Mediasoup) ───────────────────────────
# JSON 배열로 리전 목록 오버라이드 가능 (선택)
# MEDIA_REGIONS_JSON=[{"id":"ap-northeast-1","name":"서울","url":"https://media-ap1.toneknob.com","wsUrl":"wss://media-ap1.toneknob.com","latitude":37.5665,"longitude":126.978,"healthy":true}]
MEDIA_SERVER_URL_AP1=http://localhost:3002
MEDIA_WS_URL_AP1=ws://localhost:3002
MEDIA_SERVER_URL_US1=http://localhost:3003
MEDIA_WS_URL_US1=ws://localhost:3003
MEDIA_SERVER_URL_EU1=http://localhost:3004
MEDIA_WS_URL_EU1=ws://localhost:3004
