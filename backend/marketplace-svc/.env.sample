# Marketplace Service
MARKETPLACE_SVC_PORT=3006

# Database (Supabase) — 공유 DB, 각 서비스별 독립 커넥션 풀 사용
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Community Service (event target)
COMMUNITY_SVC_HOST=localhost
COMMUNITY_SVC_PORT=3005

# PortOne V2 (포트원 올인원) — 토스페이먼츠 연동
# 포트원 콘솔(https://admin.portone.io)에서 발급
# 테스트 모드: test_sk_... / 실 결제: live_sk_...
PORTONE_STORE_ID=your-portone-store-id
PORTONE_CHANNEL_KEY=your-portone-channel-key
PORTONE_API_SECRET=your-portone-v2-api-secret
# 포트원 콘솔 → 결제 연동 → 웹훅 → 시크릿 (미설정 시 웹훅 서명 검증 생략)
PORTONE_WEBHOOK_SECRET=

# Environment
NODE_ENV=development
