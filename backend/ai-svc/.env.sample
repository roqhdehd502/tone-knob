# AI Service
AI_SVC_PORT=3009

# Database (Supabase) — 공유 DB, 각 서비스별 독립 커넥션 풀 사용
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ML Server — 실제 ML 서버가 없거나 연결에 실패하면 더미 결과로 대체 동작(데모/로컬 개발용)
ML_SERVER_URL=http://localhost:8001
# ML 서버가 작업 결과를 콜백할 Gateway 공개 주소
GATEWAY_PUBLIC_URL=http://localhost:3000
# ML 서버 → Gateway 웹훅 인증용 공유 시크릿 (미설정 시 검증 생략)
ML_WEBHOOK_SECRET=

# Community Service (event target)
COMMUNITY_SVC_HOST=localhost
COMMUNITY_SVC_PORT=3005

# Environment
NODE_ENV=development
