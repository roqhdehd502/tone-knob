# ================================================================
# Tone Knob Frontend – 환경변수 샘플
# Vercel 대시보드 → Project Settings → Environment Variables 에 등록
# ================================================================

# 배포된 백엔드 URL (Vercel 백엔드 프로젝트 URL)
# 예: VITE_API_URL=https://tone-knob-api.vercel.app
VITE_API_URL=http://localhost:3000

# jam-svc WebSocket 직접 연결 URL (gateway를 거치지 않음)
# 배포 시: jam-svc가 노출되는 URL로 교체
VITE_JAM_WS_URL=http://localhost:3004

# Sentry — 클라이언트 에러 수집 (미설정 시 비활성, sentry.io 프로젝트의 DSN 입력)
VITE_SENTRY_DSN=
