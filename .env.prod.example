# ============================================================
# Tone Knob — OCI 프로덕션 환경변수 예시
# 사용법: cp .env.prod.example .env  (OCI VM에서)
#         .env 파일은 docker-compose.prod.yml 과 같은 위치에 두어야 합니다
# ============================================================

# ── Node 환경 ────────────────────────────────────────────────
NODE_ENV=production

# ── 도메인 (nginx.conf의 YOUR_DOMAIN과 동일) ─────────────────
FRONTEND_URL=https://YOUR_DOMAIN

# ── 데이터베이스 (Supabase) ──────────────────────────────────
# Supabase 콘솔 → Settings → Database → Connection string (URI)
DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# ── Redis (Docker 내부, 변경 불필요) ─────────────────────────
REDIS_URL=redis://redis:6379

# ── JWT ──────────────────────────────────────────────────────
JWT_SECRET=
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ── Supabase Storage (media-svc) ─────────────────────────────
# Supabase 콘솔 → Settings → API → service_role key
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=media

# ── PortOne V2 ───────────────────────────────────────────────
# PortOne 콘솔 → 결제 연동 → 식별코드·API Keys
PORTONE_STORE_ID=store-XXXXXXXX
PORTONE_CHANNEL_KEY=channel-key-XXXXXXXX
# 시크릿 키 (gateway에는 불필요, marketplace-svc 전용)
PORTONE_API_SECRET=
# 웹훅 시크릿 (PortOne 콘솔 → 결제알림(Webhook) 관리에서 발급)
PORTONE_WEBHOOK_SECRET=

# ── 소셜 로그인 ──────────────────────────────────────────────
# Google: console.cloud.google.com → API 및 서비스 → 사용자 인증 정보
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://YOUR_DOMAIN/api/auth/google/callback

# GitHub: github.com → Settings → Developer settings → OAuth Apps
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=https://YOUR_DOMAIN/api/auth/github/callback

# ── AI 서비스 ────────────────────────────────────────────────
ML_SERVER_URL=
ML_WEBHOOK_SECRET=
GATEWAY_PUBLIC_URL=https://YOUR_DOMAIN

# ── 서비스 포트 (변경 불필요) ────────────────────────────────
PORT=3000
AUTH_SVC_PORT=3001
TAB_SVC_PORT=3002
JAM_SVC_PORT=3003
JAM_SVC_HTTP_PORT=3004
COMMUNITY_SVC_PORT=3005
MARKETPLACE_SVC_PORT=3006
SUBSCRIPTION_SVC_PORT=3007
MEDIA_SVC_PORT=3008
AI_SVC_PORT=3009

# ── 서비스 호스트 (Docker 내부 서비스명, 변경 불필요) ──────────
AUTH_SVC_HOST=auth-svc
TAB_SVC_HOST=tab-svc
JAM_SVC_HOST=jam-svc
COMMUNITY_SVC_HOST=community-svc
MARKETPLACE_SVC_HOST=marketplace-svc
SUBSCRIPTION_SVC_HOST=subscription-svc
MEDIA_SVC_HOST=media-svc
AI_SVC_HOST=ai-svc
