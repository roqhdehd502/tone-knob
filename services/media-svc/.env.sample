# Media Service
MEDIA_SVC_PORT=3008

# CDN
CDN_BASE_URL=https://<your-project-ref>.supabase.co/storage/v1/object/public
S3_BASE_URL=https://<your-project-ref>.supabase.co/storage/v1/s3

# Supabase Storage — 파일 업로드 (미설정 시 업로드 비활성화, Supabase 대시보드에서 확인)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=media

# Media Regions (JSON override, optional)
# MEDIA_REGIONS_JSON=[{"id":"ap-northeast-1","name":"서울","url":"http://localhost:3002","wsUrl":"ws://localhost:3002","latitude":37.5665,"longitude":126.978,"healthy":true}]

# Environment
NODE_ENV=development
