# Gateway
PORT=3000

# Auth Service connection
AUTH_SVC_HOST=localhost
AUTH_SVC_PORT=3001

# Tab Service connection
TAB_SVC_HOST=localhost
TAB_SVC_PORT=3002

# Jam Service connection
JAM_SVC_HOST=localhost
JAM_SVC_PORT=3003

# Community Service connection
COMMUNITY_SVC_HOST=localhost
COMMUNITY_SVC_PORT=3005

# Marketplace Service connection
MARKETPLACE_SVC_HOST=localhost
MARKETPLACE_SVC_PORT=3006

# Subscription Service connection
SUBSCRIPTION_SVC_HOST=localhost
SUBSCRIPTION_SVC_PORT=3007

# Media Service connection
MEDIA_SVC_HOST=localhost
MEDIA_SVC_PORT=3008

# AI Service connection
AI_SVC_HOST=localhost
AI_SVC_PORT=3009

# JWT — auth-svc에서 서명한 토큰을 gateway에서 로컬 검증 (auth-svc와 동일 값 필수)
JWT_SECRET=your-jwt-secret-key

# Google OAuth2 — Google Cloud Console > API & Services > Credentials > OAuth 2.0 Client ID (Web)
# Authorized redirect URI: http://localhost:3000/api/auth/google/callback
# 미설정 시 Google 로그인 버튼은 비활성 (500 반환)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# GitHub OAuth2 — GitHub > Settings > Developer settings > OAuth Apps > New OAuth App
# Authorization callback URL: http://localhost:3000/api/auth/github/callback
# 미설정 시 GitHub 로그인 버튼은 비활성 (500 반환)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/api/auth/github/callback

# ML 서버 → /api/ai-gen/webhook/:id 콜백 인증용 공유 시크릿 (ai-svc와 동일 값, 미설정 시 검증 생략)
ML_WEBHOOK_SECRET=

# PortOne V2 — 프론트엔드 SDK 초기화용 공개 값 (서버에서 클라이언트에게 전달)
# 테스트 모드: test_ck_... / 실 결제: live_ck_...
PORTONE_STORE_ID=your-portone-store-id
PORTONE_CHANNEL_KEY=your-portone-channel-key

# CORS
FRONTEND_URL=http://localhost:5173

# Sentry — 에러 수집/모니터링 (미설정 시 SDK 비활성, sentry.io 프로젝트의 DSN 입력)
SENTRY_DSN=

# Environment
NODE_ENV=development
