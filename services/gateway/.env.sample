# Gateway
PORT=3000

# Auth Service connection
AUTH_SVC_HOST=localhost
AUTH_SVC_PORT=3001

# Tab Service connection
TAB_SVC_HOST=localhost
TAB_SVC_PORT=3002

# Jam Service connection
JAM_SVC_HOST=localhost
JAM_SVC_PORT=3003

# Community Service connection
COMMUNITY_SVC_HOST=localhost
COMMUNITY_SVC_PORT=3005

# Marketplace Service connection
MARKETPLACE_SVC_HOST=localhost
MARKETPLACE_SVC_PORT=3006

# Subscription Service connection
SUBSCRIPTION_SVC_HOST=localhost
SUBSCRIPTION_SVC_PORT=3007

# Media Service connection
MEDIA_SVC_HOST=localhost
MEDIA_SVC_PORT=3008

# AI Service connection
AI_SVC_HOST=localhost
AI_SVC_PORT=3009

# JWT — auth-svc에서 서명한 토큰을 gateway에서 로컬 검증 (auth-svc와 동일 값 필수)
JWT_SECRET=your-jwt-secret-key

# CORS
FRONTEND_URL=http://localhost:5173

# Environment
NODE_ENV=development
